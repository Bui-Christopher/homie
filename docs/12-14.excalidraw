      "isDeleted": false,
      "boundElements": [],
      "updated": 1734186469004,
      "link": null,
      "locked": false,
      "text": "The DynamicList typically involves rendering a list of items along with\nany actions (e.g., hiding, adding items). We can break it down into\nsmaller sub-components as well.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The DynamicList typically involves rendering a list of items along with any actions (e.g., hiding, adding items). We can break it down into smaller sub-components as well.",
      "autoResize": false,
      "lineHeight": 1.25
    },
