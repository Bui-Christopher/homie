      "boundElements": [],
      "updated": 1734087999366,
      "link": null,
      "locked": false,
      "text": "Non-Functional (How)\n- Performance\n    - Fast (Requests/Plotting)\n    - Few Users (Few Requests)\n- Availability\n    - Internet Connection (No Offline Mode)\n    - Page Loading (CSR)\n- Maintainability \n    - Dependent on Zillow API\n    - Logging (Failures/Bugs)\n- Interoperability\n    - Browser Web Application (Desktop/Tablet/Mobile)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "nFhrfI74ewSEi7RI9_joc",
      "originalText": "Non-Functional (How)\n- Performance\n    - Fast (Requests/Plotting)\n    - Few Users (Few Requests)\n- Availability\n    - Internet Connection (No Offline Mode)\n    - Page Loading (CSR)\n- Maintainability \n    - Dependent on Zillow API\n    - Logging (Failures/Bugs)\n- Interoperability\n    - Browser Web Application (Desktop/Tablet/Mobile)",
      "autoResize": true,
      "lineHeight": 1.25
    },
